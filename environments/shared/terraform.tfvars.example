region                       = "us-ashburn-1"
compartment_id               = "ocid1.compartment.oc1..replace_me"
tenancy_id                   = "ocid1.tenancy.oc1..replace_me"
postgres_availability_domain = "replace_me:US-ASHBURN-AD-1"
# Pin Canonical Ubuntu 24.04 aarch64, not an OKE worker image.
postgres_image_id       = "ocid1.image.oc1.iad.replace_me"
postgres_ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"
database_subnet_cidr    = "10.20.80.0/24"
database_client_cidrs   = ["10.20.30.0/24"]
bastion_client_cidrs    = [] # ["your-public-ip/32"] enables temporary management access
bastion_subnet_cidr     = "10.20.90.0/28"
# Only for the stopped Oracle resource left by the cancelled apply:
# legacy_autonomous_database_id = "ocid1.autonomousdatabase.oc1.iad.replace_me"
